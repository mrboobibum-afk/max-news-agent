{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "factor-max-bot",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-04",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "STATE",
        "class_name": "BotState"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["BotState"]
    }
  ]
}
