{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "factor-max-bot",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-04",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "STATE",
        "class_name": "BotState"
      },
      {
        "name": "MAX_API",
        "class_name": "MaxApiContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "BotState"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "MaxApiContainer"
      ]
    }
  ],
  "containers": [
    {
      "class_name": "MaxApiContainer",
      "image": "./Dockerfile",
      "max_instances": 1,
      "instance_type": "lite",
      "rollout_step_percentage": 100
    }
  ]
}
